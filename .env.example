# Copy to .env.local for local development.
# Never commit real secrets to GitHub.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=
AUTH_SECRET=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
EMAIL_PROVIDER_API_KEY=
